# Merge with the existing server .env; preserve APP_KEY and actual credentials.
# Replace API_HOST and FRONTEND_HOST with confirmed domains.
APP_NAME=SMAP
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://API_HOST
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_db
DB_USERNAME=pertaminahse
# Preserve DB_PASSWORD securely in the server .env.
SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
CORS_ALLOWED_ORIGINS=https://FRONTEND_HOST,https://API_HOST
BROADCAST_CONNECTION=reverb
# Preserve REVERB_APP_ID, REVERB_APP_KEY, REVERB_APP_SECRET from server .env.
# Laravel publishes directly to the internal Reverb listener.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=FRONTEND_HOST,API_HOST
# Existing Laravel/Vite UI connects through the public TLS proxy.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=asset.pertaminahsetc.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=no-reply@pertaminahsetc.com
MAIL_FROM_NAME="SMAP – Pertamina HETC"
# Preserve RESEND_API_KEY, GOOGLE_DRIVE_*, TELEGRAM_* and VPS_* securely.
