# Replace API_HOST with the confirmed Laravel hostname before building.
NEXT_PUBLIC_API_URL=https://API_HOST/api/v1
NEXT_PUBLIC_REVERB_APP_KEY=USE_THE_LARAVEL_REVERB_APP_KEY
NEXT_PUBLIC_REVERB_HOST=asset.pertaminahsetc.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# Firebase project must match Laravel FcmHelper/service account (smap-pertamina).
# Copy the public web app config from Firebase Console, and the public Web Push key.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=smap-pertamina
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
